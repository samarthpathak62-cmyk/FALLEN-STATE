; FALLEN STATE — Vertical Slice (Godot 4.4)
; Yeh file Godot project ki "identity card" hai.
; Godot kholo -> Import -> is folder ke andar project.godot select karo.

config_version=5

[application]

config/name="FALLEN STATE - Vertical Slice"
config/description="Living open-world prototype: 1 district, player, vehicle, NPCs, day/night, shop, missions, saves."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/core/game.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.09, 1)

[physics]

common/physics_ticks_per_second=60
